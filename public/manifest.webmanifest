{
  "name": "Palettekit",
  "short_name": "Palettekit",
  "description": "Herramientas para armar tus propias paletas: generador, paleta desde una foto, creador, chequeo de values y rampas.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ECEDEF",
  "theme_color": "#ECEDEF",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Generador de paletas", "url": "/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Paleta desde una foto", "url": "/foto/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Creador de paletas", "url": "/crear/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chequeo de values", "url": "/values/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Rampas de color", "url": "/rampas/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
